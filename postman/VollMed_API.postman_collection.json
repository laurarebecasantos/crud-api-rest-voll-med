		{
			"name": "Appointments",
			"item": [
				{
					"name": "Schedule Appointment",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"doctorId\": 1,\n    \"patientId\": 1,\n    \"appointmentDate\": \"2026-04-10T14:00:00\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/appointments",
							"host": ["{{baseUrl}}"],
							"path": ["appointments"]
						}
					},
					"response": [
						{
							"name": "201 - Consulta agendada",
							"status": "Created",
							"code": 201,
							"header": [
								{ "key": "Location", "value": "http://localhost:8082/appointments/1" }
							],
							"body": "{\n    \"id\": 1,\n    \"doctorName\": \"Dr. João Silva\",\n    \"doctorCrm\": \"123456\",\n    \"patientName\": \"Maria Souza\",\n    \"patientCpf\": \"12345678901\",\n    \"appointmentDate\": \"2026-04-10T14:00:00\",\n    \"status\": \"SCHEDULED\",\n    \"cancelReason\": null\n}"
						},
						{
							"name": "400 - Medico ja tem consulta neste horario",
							"status": "Bad Request",
							"code": 400,
							"body": "{\n    \"message\": \"Doctor already has an appointment at this time\"\n}"
						}
					]
				},
				{
					"name": "List Appointments",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/appointments?page=0&size=10",
							"host": ["{{baseUrl}}"],
							"path": ["appointments"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" },
								{ "key": "doctorId", "value": "1", "disabled": true },
								{ "key": "patientId", "value": "1", "disabled": true }
							]
						}
					},
					"response": [
						{
							"name": "200 - Lista paginada",
							"status": "OK",
							"code": 200,
							"body": "{\n    \"content\": [\n        {\n            \"id\": 1,\n            \"doctorName\": \"Dr. João Silva\",\n            \"doctorCrm\": \"123456\",\n            \"patientName\": \"Maria Souza\",\n            \"patientCpf\": \"12345678901\",\n            \"appointmentDate\": \"2026-04-10T14:00:00\",\n            \"status\": \"SCHEDULED\",\n            \"cancelReason\": null\n        }\n    ],\n    \"totalElements\": 1,\n    \"totalPages\": 1,\n    \"size\": 10,\n    \"number\": 0\n}"
						}
					]
				},
				{
					"name": "Cancel Appointment",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reason\": \"Paciente solicitou cancelamento\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/appointments/1/cancel",
							"host": ["{{baseUrl}}"],
							"path": ["appointments", "1", "cancel"]
						}
					},
					"response": [
						{
							"name": "204 - Consulta cancelada",
							"status": "No Content",
							"code": 204,
							"body": ""
						},
						{
							"name": "400 - Consulta ja cancelada",
							"status": "Bad Request",
							"code": 400,
							"body": "{\n    \"message\": \"Appointment is already cancelled\"\n}"
						}
					]
				},
				{
					"name": "Complete Appointment",
					"request": {
						"method": "PATCH",
						"url": {
							"raw": "{{baseUrl}}/appointments/1/complete",
							"host": ["{{baseUrl}}"],
							"path": ["appointments", "1", "complete"]
						}
					},
					"response": [
						{
							"name": "204 - Consulta concluida",
							"status": "No Content",
							"code": 204,
							"body": ""
						},
						{
							"name": "400 - Consulta nao esta agendada",
							"status": "Bad Request",
							"code": 400,
							"body": "{\n    \"message\": \"Only scheduled appointments can be completed\"\n}"
						}
					]
				}
			]
		}
