{
	"info": {
		"name": "Voll Med API",
		"description": "Collection completa da API Voll Med - Sistema de gestão de clínica médica",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8082"
		},
		{
			"key": "token",
			"value": ""
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"    pm.test('Token saved', function () {",
									"        pm.expect(jsonData.token).to.not.be.empty;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"login\": \"admin@vollmed.com\",\n    \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					},
					"response": [
						{
							"name": "200 - Login bem sucedido",
							"status": "OK",
							"code": 200,
							"body": "{\n    \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n}"
						},
						{
							"name": "403 - Credenciais invalidas",
							"status": "Forbidden",
							"code": 403,
							"body": ""
						}
					]
				},
				{
					"name": "Register (requer ADMIN)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"login\": \"recepcionista@vollmed.com\",\n    \"password\": \"123456\",\n    \"role\": \"RECEPTIONIST\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					},
					"response": [
						{
							"name": "200 - Usuario registrado",
							"status": "OK",
							"code": 200,
							"body": ""
						},
						{
							"name": "400 - Login ja existe",
							"status": "Bad Request",
							"code": 400,
							"body": ""
						}
					]
				}
			]
		},
		{
			"name": "Doctors",
			"item": [
				{
					"name": "Register Doctor",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Dr. João Silva\",\n    \"email\": \"joao.silva@vollmed.com\",\n    \"phone\": \"11999998888\",\n    \"crm\": \"123456\",\n    \"speciality\": \"CARDIOLOGY\",\n    \"address\": {\n        \"street\": \"Rua das Flores\",\n        \"neighborhood\": \"Centro\",\n        \"zipCode\": \"01001000\",\n        \"city\": \"São Paulo\",\n        \"state\": \"SP\",\n        \"complement\": \"Sala 101\",\n        \"number\": \"100\"\n    }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/doctors",
							"host": ["{{baseUrl}}"],
							"path": ["doctors"]
						}
					},
					"response": [
						{
							"name": "201 - Medico criado",
							"status": "Created",
							"code": 201,
							"header": [
								{ "key": "Location", "value": "http://localhost:8082/doctors/1" }
							],
							"body": "{\n    \"id\": 1,\n    \"name\": \"Dr. João Silva\",\n    \"phone\": \"11999998888\",\n    \"email\": \"joao.silva@vollmed.com\",\n    \"crm\": \"123456\",\n    \"speciality\": \"CARDIOLOGY\",\n    \"active\": true\n}"
						}
					]
				},
				{
					"name": "Get Doctor by ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/doctors/1",
							"host": ["{{baseUrl}}"],
							"path": ["doctors", "1"]
						}
					},
					"response": [
						{
							"name": "200 - Medico encontrado",
							"status": "OK",
							"code": 200,
							"body": "{\n    \"id\": 1,\n    \"name\": \"Dr. João Silva\",\n    \"phone\": \"11999998888\",\n    \"email\": \"joao.silva@vollmed.com\",\n    \"crm\": \"123456\",\n    \"speciality\": \"CARDIOLOGY\",\n    \"active\": true\n}"
						},
						{
							"name": "404 - Medico nao encontrado",
							"status": "Not Found",
							"code": 404,
							"body": ""
						}
					]
				},
				{
					"name": "List Doctors",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/doctors?page=0&size=10&sort=name",
							"host": ["{{baseUrl}}"],
							"path": ["doctors"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" },
								{ "key": "sort", "value": "name" },
								{ "key": "name", "value": "", "disabled": true },
								{ "key": "speciality", "value": "CARDIOLOGY", "disabled": true }
							]
						}
					},
					"response": [
						{
							"name": "200 - Lista paginada",
							"status": "OK",
							"code": 200,
							"body": "{\n    \"content\": [\n        {\n            \"id\": 1,\n            \"name\": \"Dr. João Silva\",\n            \"phone\": \"11999998888\",\n            \"email\": \"joao.silva@vollmed.com\",\n            \"crm\": \"123456\",\n            \"speciality\": \"CARDIOLOGY\",\n            \"active\": true\n        }\n    ],\n    \"totalElements\": 1,\n    \"totalPages\": 1,\n    \"size\": 10,\n    \"number\": 0\n}"
						}
					]
				},
				{
					"name": "Update Doctor",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Dr. João Silva Junior\",\n    \"phone\": \"11988887777\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/doctors/1",
							"host": ["{{baseUrl}}"],
							"path": ["doctors", "1"]
						}
					},
					"response": [
						{
							"name": "200 - Medico atualizado",
							"status": "OK",
							"code": 200,
							"body": "{\n    \"id\": 1,\n    \"name\": \"Dr. João Silva Junior\",\n    \"phone\": \"11988887777\",\n    \"email\": \"joao.silva@vollmed.com\",\n    \"crm\": \"123456\",\n    \"speciality\": \"CARDIOLOGY\",\n    \"active\": true\n}"
						}
					]
				},
				{
					"name": "Inactivate Doctor (soft delete)",
					"request": {
						"method": "PATCH",
						"url": {
							"raw": "{{baseUrl}}/doctors/1/status",
							"host": ["{{baseUrl}}"],
							"path": ["doctors", "1", "status"]
						}
					},
					"response": [
						{
							"name": "204 - Medico inativado",
							"status": "No Content",
							"code": 204,
							"body": ""
						}
					]
				},
				{
					"name": "Delete Doctor (hard delete - ADMIN only)",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/doctors/1",
							"host": ["{{baseUrl}}"],
							"path": ["doctors", "1"]
						}
					},
					"response": [
						{
							"name": "204 - Medico deletado",
							"status": "No Content",
							"code": 204,
							"body": ""
						}
					]
				}
			]
		},
